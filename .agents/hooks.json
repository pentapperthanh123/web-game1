{
  "auto-reviewer-pre-invocation": {
    "PreInvocation": [
      {
        "type": "command",
        "command": "python .agents/scripts/auto_reviewer.py"
      }
    ]
  },
  "auto-checklist-post-tool": {
    "PostToolUse": [
      {
        "matcher": "replace_file_content|write_to_file|multi_replace_file_content",
        "hooks": [
          {
            "type": "command",
            "command": "python .agents/scripts/checklist.py .",
            "timeout": 300
          }
        ]
      }
    ]
  }
}
