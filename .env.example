# ========================================================
# TikTok Live LOL Game - Environment Configuration
# ========================================================

# Public Network / LAN Mode:
# - 'false' (Mặc định): Chỉ mở trên Localhost (http://localhost:8000 & 8001), không lộ IP mạng nội bộ.
# - 'true': Mở mạng Public LAN (http://10.136.x.x:8000), cho phép điện thoại/OBS trong cùng Wi-Fi truy cập.
PUBLIC_NETWORK=false
VITE_PUBLIC_NETWORK=false

# Backend Server URL (Optional, defaults to local proxy or http://localhost:4000)
# VITE_SERVER_URL=http://localhost:4000
