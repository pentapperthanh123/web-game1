# Heavy raw unpacked game dumps (over 700MB, 7400+ files)
client/public/models/*_extracted/
client/public/models/*_skn_out/
client/public/models/skn_out/
client/public/models/aatrox_textures/
apps/*/client/public/models/*_extracted/
apps/*/client/public/models/*_skn_out/
apps/*/client/public/models/skn_out/
apps/*/client/public/models/aatrox_textures/

# Session cache
.agents/.session/

# AI caster TTS (local voice runtime and generated clips)
server/.tts-venv/
server/data/tts-cache/

# Heavy Background Music (> 100MB exceeds GitHub file limit)
client/public/sfx/ARENA_AMBIENCE.mp3
apps/*/client/public/sfx/ARENA_AMBIENCE.mp3

# Viet-TTS local models and generated audio (> 2GB exceeds GitHub limits)
scripts/viet-tts/pretrained-models/*.pt
scripts/viet-tts/pretrained-models/*.onnx
scripts/viet-tts/pretrained-models/*.bin
server/data/viet-tts-audio/*.mp3

# Temporary video generation build cache
scripts/video/frames/
scripts/video/clips/
