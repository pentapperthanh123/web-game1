{
  "name": "lol-tiktok-live-game-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "LoL CKTG Live Interactive Game (BLG vs Gen.G) - PNPM Monorepo",
  "scripts": {
    "dev:all": "pnpm --parallel run dev",
    "dev:all:host": "pnpm --parallel run dev:host",
    "dev:client": "pnpm --filter client dev",
    "live:client": "pnpm --filter client live",
    "dev:client:host": "pnpm --filter client dev:host",
    "dev:admin": "pnpm --filter admin dev",
    "dev:admin:host": "pnpm --filter admin dev:host",
    "dev:server": "pnpm --filter server dev",
    "build:all": "pnpm --recursive run build",
    "build:client": "pnpm --filter client build",
    "build:admin": "pnpm --filter admin build",
    "build:server": "pnpm --filter server build",
    "dev:classroom": "pnpm --parallel --filter classroom-client --filter classroom-admin dev",
    "dev:classroom:client": "pnpm --filter classroom-client dev",
    "dev:classroom:admin": "pnpm --filter classroom-admin dev",
    "build:classroom": "pnpm --filter classroom-client build && pnpm --filter classroom-admin build",
    "audio:gen": "node scripts/generateCasterAudio.mjs",
    "audio:elevenlabs": "node scripts/generateElevenLabsAudio.mjs",
    "pregenerate:tts": "node scripts/sfx/pregenerate-caster-tts.mjs",
    "pregenerate:viet-tts": "node scripts/sfx/pregenerate-caster-tts.mjs --provider=VIET_TTS",
    "pregenerate:clean": "node scripts/sfx/pregenerate-clean-tts.mjs",
    "viet-tts:docker": "docker compose -f scripts/viet-tts/docker-compose.yml up -d --build"
  }
}
