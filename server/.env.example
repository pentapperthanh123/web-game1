# HTTP + Socket.IO port
PORT=4000

# Shared secret for admin actions. Clients send it as socket handshake auth
# { adminToken } and as the `x-admin-token` header on POST/PUT/PATCH/DELETE /api/*.
# Leave empty for DEV MODE (everything allowed, warning logged at startup).
ADMIN_TOKEN=

# Comma-separated CORS allow-list for express and socket.io, e.g.
# ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174
# Leave empty to allow any origin (*).
ALLOWED_ORIGINS=

# Operator alerts over Telegram (TikTok down > 5 min, stream ended, server restarted).
# Leave empty to only log alerts locally. Create a bot with @BotFather, then put the bot
# token and the chat id that should receive alerts here.
OPS_ALERT_TELEGRAM_BOT_TOKEN=
OPS_ALERT_TELEGRAM_CHAT_ID=
# Label shown at the start of every alert (useful when running more than one room).
OPS_ALERT_INSTANCE_NAME=CKTG Live

# AI caster voice (server-side TTS). Without these the caster uses the free, unofficial
# Google Translate voice, which is fine for demos but may be throttled on a 24/7 stream.
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
# Optional voice overrides (defaults: vi-VN-HoaiMyNeural, en-US-AndrewNeural)
AZURE_SPEECH_VOICE_VI=
AZURE_SPEECH_VOICE_EN=

# Caster voice: GOOGLE_TRANSLATE (default), EDGE (run scripts\ops\setup-edge-tts.bat first) or AZURE (needs key below)
CASTER_TTS_PROVIDER=GOOGLE_TRANSLATE
# Set to GOOGLE to fill in with the Google voice when Edge/Azure is slow (mixes two voices). Default: off.
CASTER_TTS_FALLBACK_VOICE=

# Microsoft Edge neural voices (free, unofficial). Install once with scripts\ops\setup-edge-tts.bat;
# the server finds server\.tts-venv automatically. Used when no Azure key is set; Google is the fallback.
# Two casters banter by default (male NamMinh + female HoaiMy on Edge/Azure). Set true to force one male voice.
CASTER_TTS_FORCE_MALE=false
EDGE_TTS_PYTHON=
# Defaults: vi-VN-NamMinhNeural (male). Female: vi-VN-HoaiMyNeural
EDGE_TTS_VOICE_VI=
EDGE_TTS_VOICE_EN=

# TikTok Live Connection
# Target account username (without @) to connect
TIKTOK_USERNAME=bap.media.lifestyle99
# Set to true to automatically connect on server startup
AUTO_CONNECT_TIKTOK=false
# Optional sessionid cookie from logged-in browser (helps bypass TikTok WAF / Captcha blocks)
TIKTOK_SESSION_ID=
