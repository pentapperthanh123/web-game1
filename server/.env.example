# HTTP + Socket.IO port
PORT=4000

# Shared secret for admin actions. Clients send it as socket handshake auth
# { adminToken } and as the `x-admin-token` header on POST/PUT/PATCH/DELETE /api/*.
# Leave empty for DEV MODE (everything allowed, warning logged at startup).
ADMIN_TOKEN=

# Comma-separated CORS allow-list for express and socket.io, e.g.
# ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174
# Leave empty to allow any origin (*).
ALLOWED_ORIGINS=
